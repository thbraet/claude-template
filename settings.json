{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(python -m pytest *)",
      "Bash(python -m jupyter *)",
      "Bash(jupyter *)",
      "Bash(pytest *)",
      "Bash(mlflow *)",
      "Bash(dvc *)",
      "Bash(make *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch(domain:gitlab.colruytgroup.com)",
      "WebFetch(domain:confluence.colruytgroup.com)",
      "WebFetch(domain:artifactory.colruytgroup.com)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(eval *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "effortLevel": "medium",
  "autoMemoryEnabled": true,
  "enabledPlugins": {
    "compound-engineering@every-marketplace": true,
    "data@knowledge-work-plugins": true
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "30000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(printf '%s' \"$INPUT\" | jq -r '.tool_input.command // empty'); if printf '%s' \"$CMD\" | grep -qiE '\\.(env|pem|key|crt|p12|pfx|jks|secret|credential)'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Command references a sensitive file type\"}}'; fi",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "cat | bash .claude/hooks/large-file-guard.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat | bash .claude/hooks/pii-scanner.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "cat | bash .claude/hooks/phase-gate.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat | bash .claude/hooks/notebook-lint.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "cat | bash .claude/hooks/data-leakage-check.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
